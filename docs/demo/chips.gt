# Chips in a window's footer: the folder chip jumps to a folder above, the
# git chip's peek switches branches.
/resize 1200 760
/s
/wait 1800
/type cd src
/move 600 300
/wait 600
/pace 250
/record start @FRAMES@ 20
/wait 200
# the git chip, after the folder chip ("src")
/glide 108 646 500
/wait 700
/glide 115 638 250
/click 115 638
/wait 500
/slow sea
/wait 300
/key enter
/wait 1050
# the folder chip: hover shows the path, the mouse on ^ expands it
/glide 45 646 400
/wait 700
/glide 52 638 250
/wait 650
/key enter
# the folder peek closes 1 s after "cd sent"
/wait 1150
/slow git branch --show-current
/key enter
/wait 850
/record stop
/quit
