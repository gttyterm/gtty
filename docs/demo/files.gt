# Files with the mouse: hover outlines a name, double-click opens it (a
# folder: cd), hold and drag drags it out, files dropped in are copied.
/resize 1200 760
/s
/wait 1800
/type ls
/move 600 300
/wait 600
/pace 250
/record start @FRAMES@ 20
/wait 200
/glide 560 75 500
/wait 500
/dclick 560 75
/wait 650
/glide 640 75 300
/wait 350
/dclick 640 75
/wait 350
/slow ls
/key enter
/wait 350
/glide 50 141 400
/down 50 141
/wait 400
/glide 400 300 400
/up 400 300
/wait 500
/dropover 700 250
/glide 700 250 250
/wait 400
/drop 700 250 @ROOT@/Downloads/invoice.pdf
/wait 400
/slow ls
/key enter
/wait 700
/record stop
/quit
