# Folder and link names in plain output: folders blue, links with a dash
# of pink; ls -G (colors) left alone. Hover a link: a box with its target;
# a click on the box cd's to the folder the target is in. Run in a
# scratch folder:
#   mkdir -p w/sub w/'My Dir' other/deep && cd w && touch notes.txt
#   ln -s notes.txt link-file && ln -s sub link-dir && ln -s ../other/deep far
#   gtty --script $REPO/test/names.gt
# Expect: n1 blue My Dir / sub, pink-tinted links, ls -G untouched; n2 the
# box over far ("→ …/other/deep", "click: cd to other"); n3 pwd = other.
/s bash
/wait 1500
/type clear
/wait 500
/type ls -1
/wait 800
/type ls -G
/wait 800
/shot ../n1.bmp
/type clear
/wait 500
/type ls -1
/wait 1500
# far is the 2nd row
/move 30 102
/wait 1200
/shot ../n2.bmp
/move 60 68
/wait 300
/click 60 68
/wait 800
/type pwd
/wait 600
/shot ../n3.bmp
/quit
