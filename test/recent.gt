# The recent chip: commands run in folders under home count (not cd / ls /
# pwd), a click on the chip opens the list expanded at once (most used
# first, the current folder green, home itself never), Enter cds there.
# Run with a scratch home and recent file:
#   S=$(mktemp -d); mkdir -p $S/home/alpha $S/home/beta $S/home/gamma
#   printf '9\t%s\t%s\n' $(date +%s) $S/home/gamma > $S/recent
#   cd $S && HOME=$S/home GTTY_RECENT=$S/recent gtty --script $REPO/test/recent.gt
# Shots go to $S; $S/recent then lists alpha (2), beta (1), gamma (9).
/s bash
/wait 1500
/type cd ~/alpha
/wait 300
/type date
/wait 300
/type uname
/wait 300
/type ls
/wait 300
/type cd ~/beta
/wait 300
/type pwd
/wait 300
/type date
/wait 300
/type cd ~
/wait 300
/type date
/wait 600
/shot recent1-chips.bmp
/click 210 620
/wait 400
/shot recent2-list.bmp
/key enter
/wait 800
/shot recent3-cd.bmp
/quit
